<Project ToolsVersion="14.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OutputPath>bin\PressCampaignHarness\</OutputPath>
    <IntermediateOutputPath>obj\PressCampaignHarness\</IntermediateOutputPath>
    <StartupObject>PressCampaignHarness</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Compile Include="..\PressCampaignScheduler.vb"><Link>PressCampaignScheduler.vb</Link></Compile>
    <Compile Include="PressCampaignHarness.vb" />
    <Compile Include="ReferencePressCampaignScheduler.vb" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
</Project>
